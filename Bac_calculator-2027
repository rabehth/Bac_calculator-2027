<style>
/* حاسبة معدل البكالوريا الجزائرية 2027 — الأنماط (CSS) */
/* ===== متغيرات التصميم: الألوان، الحواف، الظلال ===== */
  :root{
    --bg:#F3F5FB;
    --card:#FFFFFF;
    --card-border:#E8EAF3;
    --ink:#1A1E2E;
    --ink-soft:#6B7280;
    --ink-faint:#9CA3AF;
    --primary:#4F46E5;
    --primary-dark:#4338CA;
    --primary-soft:#EEEEFE;
    --success:#16A34A;
    --success-soft:#E9F9EE;
    --danger:#DC2626;
    --danger-soft:#FDEDEC;
    --amber:#D97706;
    --amber-soft:#FEF3E2;
    --topbar-bg:rgba(243,245,251,0.85);
    --input-bg:#FBFBFE;
    --r-lg:22px;
    --r-md:16px;
    --r-sm:11px;
    --sh-sm:0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.07);
    --sh-md:0 6px 16px rgba(16,24,40,.08), 0 2px 6px rgba(16,24,40,.05);
    --sh-lg:0 16px 40px rgba(16,24,40,.14);
    --ease:cubic-bezier(.22,1,.36,1);
  }

  /* ===== الوضع الليلي: تجاوز نفس المتغيرات بألوان داكنة مريحة للعين ===== */
  html[data-theme="dark"]{
    --bg:#12141C;
    --card:#1B1F2B;
    --card-border:#2A2F3F;
    --ink:#F0F2F8;
    --ink-soft:#A9AFC3;
    --ink-faint:#767C90;
    --primary:#7C6FF0;
    --primary-dark:#9B90FF;
    --primary-soft:#26234A;
    --success:#22C55E;
    --success-soft:#123321;
    --danger:#F87171;
    --danger-soft:#3B1A1A;
    --amber:#FBBF24;
    --amber-soft:#3A2A0A;
    --topbar-bg:rgba(18,20,28,0.85);
    --input-bg:#11141C;
  }
  body{ transition:background-color .3s ease, color .3s ease; }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    font-family:'IBM Plex Sans Arabic',sans-serif;
    color:var(--ink);
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  .app{
    max-width:560px;
    margin:0 auto;
    padding:0 0 60px;
  }

  /* ===== الشريط العلوي: الشعار وشريط التقدّم ===== */
  .topbar{
    position:sticky; top:0; z-index:20;
    background:var(--topbar-bg);
    backdrop-filter:blur(14px) saturate(160%);
    -webkit-backdrop-filter:blur(14px) saturate(160%);
    padding:16px 20px 12px;
    border-bottom:1px solid var(--card-border);
  }
  .brand{
    display:flex; align-items:center; gap:12px;
  }
  .brand img{width:42px;height:42px;border-radius:12px;box-shadow:var(--sh-sm);}
  .brand-text{flex:1; min-width:0;}
  .brand-text h1{
    font-size:16px; font-weight:700; margin:0; line-height:1.3;
  }
  .brand-text .tag{
    font-size:11.5px; color:var(--ink-soft); font-weight:500;
  }
  .theme-toggle{
    flex:0 0 auto;
    width:42px; height:42px;
    border-radius:12px;
    border:1px solid var(--card-border);
    background:var(--card);
    font-size:18px;
    cursor:pointer;
    box-shadow:var(--sh-sm);
    transition:transform .15s var(--ease), background .2s ease;
  }
  .theme-toggle:active{transform:scale(0.9);}

  .progress-row{
    display:flex; align-items:center; gap:10px;
    margin-top:14px;
  }
  .progress-track{
    flex:1; height:8px; border-radius:99px;
    background:var(--card-border);
    overflow:hidden;
  }
  .progress-fill{
    height:100%; border-radius:99px;
    background:linear-gradient(90deg, var(--primary), #7C6FF0);
    width:0%;
    transition:width .5s var(--ease);
  }
  .progress-label{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px; font-weight:600; color:var(--primary-dark);
    min-width:38px; text-align:left;
  }
  .progress-count{
    font-size:11px; color:var(--ink-faint); margin-top:6px;
    font-family:'IBM Plex Mono',monospace;
  }

  /* ===== تنبيه المواد الناقصة ===== */
  .missing-banner{
    display:none;
    margin:12px 20px 0;
    background:var(--amber-soft);
    color:var(--amber);
    border-radius:var(--r-md);
    padding:12px 14px;
    font-size:12.5px; line-height:1.8;
    animation:cardIn .35s var(--ease);
  }
  .missing-banner.show{display:block;}
  .missing-banner b{font-weight:700;}

  /* ===== منتقي الشعبة (أزرار قابلة للتمرير أفقيًا داخل حاويتها فقط) ===== */
  .branch-scroller{
    display:flex; gap:8px; overflow-x:auto;
    padding:16px 20px 4px;
    scrollbar-width:none;
  }
  .branch-scroller::-webkit-scrollbar{display:none;}
  .chip{
    flex:0 0 auto;
    font-family:'IBM Plex Sans Arabic',sans-serif;
    font-weight:600; font-size:13.5px;
    padding:10px 16px;
    border-radius:99px;
    border:1px solid var(--card-border);
    background:var(--card);
    color:var(--ink);
    cursor:pointer;
    box-shadow:var(--sh-sm);
    display:flex; align-items:center; gap:6px;
    transition:transform .18s var(--ease), background .18s ease, color .18s ease, box-shadow .18s ease;
  }
  .chip:active{transform:scale(0.95);}
  .chip.active{
    background:var(--primary);
    color:#fff;
    border-color:var(--primary);
    box-shadow:0 6px 16px rgba(79,70,229,.32);
  }
  .chip .dot{width:6px;height:6px;border-radius:50%;flex:0 0 auto;}
  .chip .dot.new{background:#16A34A;}
  .chip.active .dot.new{background:#BBF7D0;}
  .chip .dot.old{background:#D97706;}
  .chip.active .dot.old{background:#FDE9C7;}

  .legend{
    display:flex; gap:16px; justify-content:center;
    font-size:11px; color:var(--ink-faint);
    padding:2px 20px 6px;
  }
  .legend span{display:flex; align-items:center; gap:5px;}
  .legend .dot{width:6px;height:6px;border-radius:50%;}
  .legend .dot.new{background:#16A34A;}
  .legend .dot.old{background:#D97706;}

  /* ===== بطاقات المواد الإجبارية ===== */
  .cards{
    padding:8px 20px 4px;
    display:flex; flex-direction:column; gap:10px;
  }
  .card{
    background:var(--card);
    border:1px solid var(--card-border);
    border-radius:var(--r-md);
    padding:14px 16px;
    box-shadow:var(--sh-sm);
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    opacity:0; transform:translateY(8px);
    animation:cardIn .45s var(--ease) forwards;
    transition:box-shadow .2s ease, border-color .2s ease;
  }
  .card.filled{
    border-color:rgba(79,70,229,.25);
    box-shadow:0 2px 10px rgba(79,70,229,.08);
  }
  .card:focus-within{
    border-color:var(--primary);
    box-shadow:0 0 0 4px var(--primary-soft);
  }
  @keyframes cardIn{
    to{opacity:1; transform:translateY(0);}
  }
  .card-left{display:flex; flex-direction:column; align-items:flex-start; gap:2px; min-width:0; flex:1;}
  .subject-name{
    font-weight:600; font-size:14.5px;
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:100%;
  }
  .subject-pts{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px; font-weight:500;
    color:var(--ink-faint);
    transition:color .2s ease;
  }
  .card.filled .subject-pts{ color:var(--primary-dark); }
  .coef-pill{
    font-family:'IBM Plex Mono',monospace;
    font-weight:600; font-size:12px;
    background:var(--primary-soft);
    color:var(--primary-dark);
    padding:3px 9px;
    border-radius:99px;
    flex:0 0 auto;
  }
  .mark-field{
    position:relative;
    flex:0 0 auto;
  }
  .field-clear{
    position:absolute; top:-6px; left:-6px;
    width:20px; height:20px; border-radius:50%;
    border:none; background:var(--ink-faint); color:#fff;
    font-size:12px; line-height:1; cursor:pointer;
    display:none; align-items:center; justify-content:center;
    box-shadow:0 1px 3px rgba(0,0,0,.2);
    transition:background .15s ease, transform .15s ease;
  }
  .field-clear.show{display:flex;}
  .field-clear:active{transform:scale(0.85);}
  .field-clear:hover{background:var(--danger);}
  input.mark{
    width:78px;
    padding:9px 6px;
    font-family:'IBM Plex Mono',monospace;
    font-size:15px; font-weight:600;
    text-align:center;
    border:1.5px solid var(--card-border);
    border-radius:var(--r-sm);
    background:var(--input-bg);
    color:var(--ink);
    transition:border-color .18s ease, box-shadow .18s ease, background .18s ease;
  }
  input.mark::placeholder{
    font-family:'IBM Plex Sans Arabic',sans-serif;
    font-size:10.5px; font-weight:500;
    color:var(--ink-faint);
  }
  input.mark:focus{
    outline:none;
    border-color:var(--primary);
    background:var(--card);
    box-shadow:0 0 0 4px var(--primary-soft);
  }
  input.mark.valid{border-color:rgba(22,163,74,.45); background:var(--success-soft);}
  input.mark.err{border-color:var(--danger); background:var(--danger-soft); animation:shake .32s ease;}
  @keyframes shake{
    0%,100%{transform:translateX(0);} 25%{transform:translateX(-4px);} 75%{transform:translateX(4px);}
  }

  /* ===== بطاقات المواد الاختيارية (الأمازيغية والتربية البدنية) ===== */
  .opt-card{
    background:var(--card);
    border:1px dashed var(--card-border);
    border-radius:var(--r-md);
    padding:12px 16px;
    display:flex; flex-direction:column; gap:10px;
    animation:cardIn .45s var(--ease) forwards;
    opacity:0; transform:translateY(8px);
  }
  .opt-head{
    display:flex; align-items:center; justify-content:space-between; gap:10px;
  }
  .opt-title{
    font-size:13.5px; font-weight:600; color:var(--ink);
  }
  .opt-sub{
    font-size:11px; color:var(--ink-faint); margin-top:2px; line-height:1.5;
  }
  /* مفتاح تفعيل (Toggle Switch) بحجم مريح للمس على الهاتف */
  .switch{
    position:relative; width:48px; height:28px; flex:0 0 auto;
  }
  .switch input{opacity:0; width:0; height:0; position:absolute;}
  .switch-track{
    position:absolute; inset:0;
    background:#D1D5DB;
    border-radius:99px;
    cursor:pointer;
    transition:background .25s ease;
  }
  .switch-track::before{
    content:"";
    position:absolute; top:3px; right:3px;
    width:22px; height:22px; border-radius:50%;
    background:#fff;
    box-shadow:0 1px 3px rgba(0,0,0,.25);
    transition:transform .25s var(--ease);
  }
  .switch input:checked + .switch-track{background:var(--primary);}
  .switch input:checked + .switch-track::before{transform:translateX(-20px);}

  .opt-body{
    max-height:0; overflow:hidden;
    transition:max-height .32s var(--ease), opacity .28s ease;
    opacity:0;
    display:flex; align-items:center; gap:10px;
  }
  .opt-body.open{max-height:70px; opacity:1; padding-top:2px;}
  .opt-label-text{
    font-size:12.5px; color:var(--ink-soft);
    flex:1; min-width:0;
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  }
  .opt-body .subject-pts{ flex:0 0 auto; }

  /* ===== بطاقة النتيجة النهائية (حلقة المعدل) ===== */
  .result{
    margin:22px 20px 0;
    background:var(--card);
    border:1px solid var(--card-border);
    border-radius:var(--r-lg);
    box-shadow:var(--sh-md);
    padding:26px 20px;
    display:flex; align-items:center; gap:22px;
    transition:box-shadow .3s ease;
  }
  .result.reveal{ animation:resultReveal .55s var(--ease); }
  @keyframes resultReveal{
    0%{ transform:scale(0.97); box-shadow:var(--sh-sm); }
    55%{ transform:scale(1.015); }
    100%{ transform:scale(1); box-shadow:var(--sh-md); }
  }
  .ring-wrap{ position:relative; width:118px; height:118px; flex:0 0 auto;}
  .ring-wrap svg{ width:118px; height:118px; transform:rotate(-90deg);}
  .ring-bg{ fill:none; stroke:var(--card-border); stroke-width:10;}
  .ring-fg{
    fill:none; stroke:var(--ink-faint); stroke-width:10;
    stroke-linecap:round;
    stroke-dasharray:314;
    stroke-dashoffset:314;
    transition:stroke-dashoffset .6s var(--ease), stroke .4s ease;
  }
  .ring-center{
    position:absolute; inset:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
  }
  .ring-val{ font-family:'IBM Plex Mono',monospace; font-weight:700; font-size:24px; color:var(--ink);}
  .ring-lbl{ font-size:10px; color:var(--ink-faint); font-weight:500; margin-top:1px;}

  .verdict-wrap{flex:1; min-width:0;}
  .branch-name{
    font-size:11.5px; font-weight:600; color:var(--primary-dark);
    background:var(--primary-soft);
    display:inline-block; padding:3px 10px; border-radius:99px;
    margin-bottom:8px;
  }
  .verdict-row{display:flex; align-items:center; gap:8px; flex-wrap:wrap;}
  .verdict{ font-size:19px; font-weight:700; color:var(--ink-soft); transition:color .3s ease;}
  .grade-badge{
    font-size:11px; font-weight:700;
    padding:3px 10px; border-radius:99px;
    display:none;
  }
  .grade-badge.show{display:inline-block;}
  .grade-badge.success{background:var(--success-soft); color:var(--success);}
  .grade-badge.primary{background:var(--primary-soft); color:var(--primary-dark);}
  .grade-badge.amber{background:var(--amber-soft); color:var(--amber);}
  .grade-badge.danger{background:var(--danger-soft); color:var(--danger);}
  .verdict-sub{ font-size:12.5px; color:var(--ink-faint); margin-top:6px; line-height:1.6;}
  .totals-mini{
    display:flex; gap:14px; margin-top:10px; flex-wrap:wrap;
    font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--ink-faint);
  }

  /* ===== صندوق شرح طريقة الحساب ===== */
  .method-box{
    margin:14px 20px 0;
    background:var(--primary-soft);
    border-radius:var(--r-md);
    padding:13px 16px;
    font-size:12.5px;
    color:var(--primary-dark);
    line-height:1.7;
    display:flex; align-items:flex-start; gap:9px;
  }
  .method-box .ic{flex:0 0 auto; font-size:15px; line-height:1.4;}

  /* ===== أزرار الإجراءات: إعادة تعيين / نسخ / مشاركة ===== */
  .actions{
    display:grid; grid-template-columns:1fr 1fr; gap:10px;
    margin:16px 20px 0;
  }
  .actions .action-btn:last-child:nth-child(odd){ grid-column:1 / -1; }
  .action-btn{
    min-height:50px;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px;
    border-radius:var(--r-md);
    border:1px solid var(--card-border);
    background:var(--card);
    color:var(--ink);
    font-family:'IBM Plex Sans Arabic',sans-serif;
    font-weight:600; font-size:12px;
    cursor:pointer;
    box-shadow:var(--sh-sm);
    transition:transform .15s var(--ease), box-shadow .15s ease, background .15s ease;
  }
  .action-btn .ic{font-size:18px; line-height:1;}
  .action-btn:active{transform:scale(0.95);}
  .action-btn.primar
